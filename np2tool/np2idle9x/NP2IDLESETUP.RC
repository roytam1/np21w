#include <windows.h>
#include "RESOURCE.H"
#include "VERSION.H"

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDI_NP2IDLE ICON DISCARDABLE "np2setup.ico"

1 VERSIONINFO
 FILEVERSION NP2IDLE_VERSION_TUPLE
 PRODUCTVERSION NP2IDLE_VERSION_TUPLE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041103A4"
        BEGIN
            VALUE "CompanyName",      "Neko Project 21/W utility\0"
            VALUE "FileDescription",  "NP2IDLE インストーラ/アンインストーラ\0"
            VALUE "FileVersion",      "1.3.4.1\0"
            VALUE "InternalName",     "NP2IDLESETUP\0"
            VALUE "LegalCopyright",   "Provided as source code\0"
            VALUE "OriginalFilename", "NP2IDLESETUP.EXE\0"
            VALUE "ProductName",      "NP2IDLE\0"
            VALUE "ProductVersion",   "1.3.4.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 932
    END
END
